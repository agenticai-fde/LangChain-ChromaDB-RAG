# Folder with your documents (.pdf, .txt, .md)
DOCS_FOLDER=docs

# Where ChromaDB saves the vectors
CHROMA_FOLDER=chroma_db
COLLECTION_NAME=my_documents

# Ollama models
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
CHAT_MODEL=llama3.2

# Splitting and retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=4
